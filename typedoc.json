{
  "$schema": "https://typedoc.org/schema.json",
  "name": "MrFigg's TypeDoc Plugins",
  "entryPoints": ["./src/index.ts"],
  "cleanOutputDir": true,
  "disableSources": true,
  "includeHierarchySummary": false,
  "headings": {
    "readme": false
  },
  "validation": {
    "invalidPath": false
  },
  "navigationLinks": {
    "GitHub": "https://github.com/mrfigg/typedoc-plugins"
  },
  "plugin": ["typedoc-plugin-iconify-navigation-links"],
  "iconifyNavigationLinks": {
    "GitHub": "ant-design:github-filled"
  }
}
