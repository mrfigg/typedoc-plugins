{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Iconify",
  "entryPoints": ["./src/index.ts"],
  "disableSources": true,
  "includeHierarchySummary": false,
  "headings": {
    "readme": false
  },
  "navigationLinks": {
    "GitHub": "https://github.com/mrfigg/typedoc-plugins/tree/main/plugins/iconify"
  },
  "plugin": [
    "typedoc-plugin-document-page-headings",
    "typedoc-plugin-iconify",
    "typedoc-plugin-iconify-navigation-links",
    "typedoc-plugin-replace-text",
    "typedoc-plugin-version-header"
  ],
  "iconifyNavigationLinks": {
    "GitHub": "ant-design:github-filled"
  },
  "replaceText": {
    "replacements": [
      {
        "pattern": "(?<=^#+\\ )typedoc-plugin-iconify",
        "flags": "gmis",
        "replace": "Iconify"
      },
      {
        "pattern": "#+ Example(?:(?!^#).)*",
        "flags": "gmis",
        "replace": ""
      }
    ]
  }
}
